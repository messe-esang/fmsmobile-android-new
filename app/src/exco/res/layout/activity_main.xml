<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <LinearLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".ui.MainActivity">

        <include layout="@layout/include_home_toolbar" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="5dp">

                    <RelativeLayout
                        android:id="@+id/layout_search"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@color/color_E0E0E3"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/editID"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_centerVertical="true"
                            android:layout_margin="8dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/edittext_search_bg"
                            android:drawableLeft="@android:drawable/ic_menu_search"
                            android:focusable="false"
                            android:gravity="center_vertical"
                            android:hint="업체/브랜드 검색"
                            android:inputType="text"
                            android:maxLength="20"
                            android:text="" />
                    </RelativeLayout>
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbarSize="4dp"
                    android:scrollbarThumbVertical="@color/color_accent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/name_card_layout_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="2dp"
                            android:background="@drawable/main_line_org_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/ic_camera" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="start"
                                        android:text="@string/str_title_name_card"
                                        android:textColor="@android:color/white"
                                        android:textSize="18dp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="start"
                                        android:text="@string/str_title_sub_name_card"
                                        android:textColor="@android:color/white"
                                        android:textSize="10dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/color_gray"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/allocation_layout"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_marginEnd="1dp"
                                android:layout_weight="1"
                                android:background="@drawable/main_line_bg"
                                android:foreground="?attr/selectableItemBackground"
                                android:orientation="vertical"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginBottom="13dp"
                                    android:text="@string/str_title_allocation"
                                    android:textColor="@color/color_class_allocation"
                                    android:textSize="30dp"
                                    android:textStyle="bold" />

                                <RelativeLayout
                                    android:id="@+id/assign_relative_layout"
                                    android:layout_width="match_parent"
                                    android:layout_height="185dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_above="@+id/assign_txt"
                                        android:orientation="vertical">

                                        <androidx.recyclerview.widget.RecyclerView
                                            android:id="@+id/assign_recyclerview"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content" />

                                        <LinearLayout
                                            android:id="@+id/assign_tot_my"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:gravity="right"
                                            android:orientation="horizontal"
                                            android:visibility="gone">

                                            <Space
                                                android:layout_width="0dp"
                                                android:layout_height="match_parent"
                                                android:layout_weight="0.5" />

                                            <TextView
                                                android:id="@+id/assign_tot_title"
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_marginRight="15dp"
                                                android:layout_weight="1"
                                                android:gravity="right"
                                                android:text="Total"
                                                android:textColor="@color/color_class_company"
                                                android:textSize="11dp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/assign_my_title"
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="1"
                                                android:gravity="right"
                                                android:text="My"
                                                android:textColor="@color/color_DC6A7A"
                                                android:textSize="11dp"
                                                android:textStyle="bold" />
                                        </LinearLayout>

                                        <TextView
                                            android:id="@+id/assign_Empty"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:gravity="center"
                                            android:text="등록된 배정내역이 없습니다."
                                            android:visibility="gone" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/assign_txt"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentRight="true"
                                        android:layout_alignParentBottom="true"
                                        android:layout_gravity="right"
                                        android:layout_marginTop="0dp"
                                        android:layout_marginBottom="2dp"
                                        android:text="[처리율]"
                                        android:textColor="@color/color_B1B8C8"
                                        android:textSize="13dp"
                                        android:textStyle="bold" />
                                </RelativeLayout>
                            </LinearLayout>


                            <LinearLayout
                                android:id="@+id/fair_layout"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_marginEnd="1dp"
                                android:layout_weight="1"
                                android:background="@drawable/main_line_bg"
                                android:foreground="?attr/selectableItemBackground"
                                android:orientation="vertical"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginBottom="13dp"
                                    android:text="@string/str_title_event"
                                    android:textColor="@color/color_class_event"
                                    android:textSize="30dp"
                                    android:textStyle="bold" />

                                <RelativeLayout
                                    android:id="@+id/fair_relative_layout"
                                    android:layout_width="match_parent"
                                    android:layout_height="185dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_above="@+id/fair_txt"
                                        android:orientation="vertical">

                                        <androidx.recyclerview.widget.RecyclerView
                                            android:id="@+id/fair_recyclerview"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content" />

                                        <TextView
                                            android:id="@+id/fair_Empty"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:gravity="center"
                                            android:text="등록된 행사내역이 없습니다."
                                            android:visibility="gone" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/fair_txt"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentRight="true"
                                        android:layout_alignParentBottom="true"
                                        android:layout_gravity="right"
                                        android:layout_marginTop="0dp"
                                        android:layout_marginBottom="2dp"
                                        android:text="[매출금액]"
                                        android:textColor="@color/color_B1B8C8"
                                        android:textSize="13dp"
                                        android:textStyle="bold" />
                                </RelativeLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/sales_layout"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_marginStart="1dp"
                                android:layout_weight="1"
                                android:background="@drawable/main_line_bg"
                                android:foreground="?attr/selectableItemBackground"
                                android:orientation="vertical"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginBottom="13dp"
                                    android:text="@string/str_title_sales"
                                    android:textColor="@color/color_class_sales"
                                    android:textSize="30dp"
                                    android:textStyle="bold" />

                                <RelativeLayout
                                    android:id="@+id/sales_relative_layout"
                                    android:layout_width="match_parent"
                                    android:layout_height="185dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_above="@+id/sales_txt"
                                        android:orientation="vertical">

                                        <androidx.recyclerview.widget.RecyclerView
                                            android:id="@+id/sales_recyclerview"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content" />

                                        <TextView
                                            android:id="@+id/sales_Empty"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:gravity="center"
                                            android:text="등록된 영업내역이 없습니다."
                                            android:visibility="gone" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/sales_txt"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentRight="true"
                                        android:layout_alignParentBottom="true"
                                        android:layout_gravity="right"
                                        android:layout_marginTop="0dp"
                                        android:layout_marginBottom="2dp"
                                        android:text="[부스수]"
                                        android:textColor="@color/color_B1B8C8"
                                        android:textSize="13dp"
                                        android:textStyle="bold" />
                                </RelativeLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/preregistration_layout"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_marginStart="1dp"
                                android:layout_weight="1"
                                android:background="@drawable/main_line_bg"
                                android:foreground="?attr/selectableItemBackground"
                                android:orientation="vertical"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginBottom="13dp"
                                    android:text="@string/str_title_preregistration"
                                    android:textColor="@color/color_C9B5AF"
                                    android:textSize="30dp"
                                    android:textStyle="bold" />

                                <RelativeLayout
                                    android:id="@+id/preregistration_relative_layout"
                                    android:layout_width="match_parent"
                                    android:layout_height="185dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_above="@+id/preregistration_txt"
                                        android:orientation="vertical">

                                        <androidx.recyclerview.widget.RecyclerView
                                            android:id="@+id/preregistration_recyclerview"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content" />

                                        <TextView
                                            android:id="@+id/preregistration_Empty"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:gravity="center"
                                            android:text="사전등록 내역이 없습니다."
                                            android:visibility="gone" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/preregistration_txt"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentRight="true"
                                        android:layout_alignParentBottom="true"
                                        android:layout_gravity="right"
                                        android:layout_marginTop="0dp"
                                        android:layout_marginBottom="2dp"
                                        android:text="[전체건수]"
                                        android:textColor="@color/color_B1B8C8"
                                        android:textSize="13dp"
                                        android:textStyle="bold" />
                                </RelativeLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/receivable_layout"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_marginTop="2dp"
                                android:layout_marginEnd="1dp"
                                android:layout_weight="1"
                                android:background="@drawable/main_line_bg"
                                android:foreground="?attr/selectableItemBackground"
                                android:orientation="vertical"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginBottom="13dp"
                                    android:text="@string/str_title_receivable"
                                    android:textColor="@color/color_class_receivable"
                                    android:textSize="30dp"
                                    android:textStyle="bold" />

                                <RelativeLayout
                                    android:id="@+id/rec_relative_layout"
                                    android:layout_width="match_parent"
                                    android:layout_height="185dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:orientation="vertical">

                                        <androidx.recyclerview.widget.RecyclerView
                                            android:id="@+id/rec_recyclerview"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content" />

                                        <TextView
                                            android:id="@+id/rec_Empty"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_marginBottom="25dp"
                                            android:gravity="center"
                                            android:text="등록된 채권내역이 없습니다."
                                            android:visibility="gone" />
                                    </LinearLayout>
                                </RelativeLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/notification_layout"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_marginStart="1dp"
                                android:layout_marginTop="2dp"
                                android:layout_weight="1"
                                android:background="@drawable/main_line_bg"
                                android:foreground="?attr/selectableItemBackground"
                                android:orientation="vertical"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginBottom="10dp"
                                    android:text="@string/str_title_notification"
                                    android:textColor="@color/color_class_notification"
                                    android:textSize="30dp"
                                    android:textStyle="bold" />

                                <RelativeLayout
                                    android:id="@+id/noti_relative_layout"
                                    android:layout_width="match_parent"
                                    android:layout_height="185dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:orientation="vertical">

                                        <androidx.recyclerview.widget.RecyclerView
                                            android:id="@+id/noti_recyclerview"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content" />

                                        <TextView
                                            android:id="@+id/noti_Empty"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_marginBottom="25dp"
                                            android:gravity="center"
                                            android:text="등록된 알림내역이 없습니다."
                                            android:visibility="visible" />
                                    </LinearLayout>
                                </RelativeLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/event_layout_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/main_line_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/str_title_event"
                                android:textColor="@color/color_class_event"
                                android:textSize="30dp"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/preregistration_layout_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/main_line_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <!--<View-->
                            <!--android:layout_width="match_parent"-->
                            <!--android:layout_height="0.5dp"-->
                            <!--android:background="@color/color_gray"/>-->

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/str_title_preregistration"
                                android:textColor="@color/color_C9B5AF"
                                android:textSize="30dp"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/admission_statistics_layout_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/main_line_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/str_title_annual_visitor_statistics"
                                android:textColor="@color/color_FFF4D5"
                                android:textSize="30dp"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/entrance_status_layout_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/main_line_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/str_title_visitor_status"
                                android:textColor="@color/color_D9CCB6"
                                android:textSize="30dp"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/receivable_layout_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/main_line_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/str_title_receivable"
                                android:textColor="@color/color_class_receivable"
                                android:textSize="30dp"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/notification_layout_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/main_line_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/str_title_notification"
                                android:textColor="@color/color_class_notification"
                                android:textSize="30dp"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/color_gray"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/progressBar_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#40000000"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <fr.castorflex.android.circularprogressbar.CircularProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:indeterminate="true"
                    app:cpb_colors="@array/home_colors" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"

        app:headerLayout="@layout/nav_header_main"
        app:itemIconTint="@color/color_primary"
        app:menu="@menu/activity_main_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>