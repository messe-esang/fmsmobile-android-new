<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical">

    <LinearLayout
            android:id="@+id/assign_list_item_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="8dp">

        <CheckBox android:layout_width="wrap_content"
                  android:visibility="gone"
                  android:id="@+id/assign_chk_box"
                  android:layout_height="wrap_content"/>
        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_weight="1.0"
                android:orientation="vertical">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_height="wrap_content">
                <LinearLayout android:layout_width="0dp"
                              android:orientation="horizontal"
                              android:layout_weight="1"
                              android:layout_gravity="center"
                              android:layout_height="wrap_content">
                    <TextView
                            android:id="@+id/assign_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/color_030303"
                            android:textSize="18dp"
                            android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp"
                              android:orientation="horizontal"
                              android:layout_weight="0.4"
                              android:layout_gravity="center"
                              android:gravity="right"
                              android:layout_height="wrap_content">
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="3dp"
                            android:text="영업등급 :"
                            android:textColor="@color/color_9A9A9A"
                            android:textSize="13dp"
                            android:textStyle="bold"/>

                    <TextView
                            android:id="@+id/assign_class"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/color_396AC0"
                            android:textSize="13dp"
                            android:textStyle="bold"/>

                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="left|center"
                    android:orientation="horizontal"
                    android:visibility="visible">

                <LinearLayout android:layout_width="0dp"
                              android:orientation="horizontal"
                              android:layout_weight="1"
                              android:layout_height="wrap_content">
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:text="배정요청 담당자 :"
                            android:textColor="@color/color_9A9A9A"
                            android:textSize="13dp"
                            android:textStyle="bold"/>

                    <TextView
                            android:id="@+id/assign_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:textSize="13dp"
                            android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp"
                              android:orientation="horizontal"
                              android:layout_weight="1"
                              android:gravity="right"
                              android:layout_height="wrap_content">
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="3dp"
                            android:text="배정요청일 :"
                            android:textColor="@color/color_9A9A9A"
                            android:textSize="13dp"
                            android:textStyle="bold"/>

                    <TextView
                            android:id="@+id/assign_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:textSize="13dp"
                            android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_gray"/>
</LinearLayout>