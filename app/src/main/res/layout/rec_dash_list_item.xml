<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rec_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/rec_layout_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/color_class_company"
        android:textSize="12dp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center|right"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:text="Total"
            android:textColor="@color/color_class_company"
            android:textSize="12dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rec_tot_cnt_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:textColor="@color/color_class_company"
            android:textSize="14.6dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:text="|"
            android:textColor="@color/color_class_company"
            android:textSize="14.6dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rec_tot_cnt_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_rec_tot_cnt"
            android:textColor="@color/color_class_company"
            android:textSize="14.6dp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rec_my_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center|right"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:text="My"
            android:textColor="@color/color_class_allocation"
            android:textSize="12dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rec_my_cnt_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:textColor="@color/color_class_allocation"
            android:textSize="14.6dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="3dp"
            android:text="|"
            android:textColor="@color/color_class_allocation"
            android:textSize="14.6dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rec_my_cnt_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_rec_my_cnt"
            android:textColor="@color/color_class_allocation"
            android:textSize="14.6dp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>