<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/activity_horizontal_margin"
    android:layout_marginTop="@dimen/activity_vertical_margin_little"
    android:layout_marginRight="@dimen/activity_horizontal_margin"
    android:layout_marginBottom="@dimen/activity_vertical_margin_little"
    android:clickable="true"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/txtTitle"
        style="@style/TextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/pen_ico"
        android:drawablePadding="5dp"
        android:gravity="start|center_vertical"
        android:text=""
        android:textColor="@color/color_class_receivable" />

</LinearLayout>