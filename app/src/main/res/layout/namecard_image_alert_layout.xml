    <!-- 팝업 컨테이너 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/namecard_edit_rounded_bg"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 이미지 -->
