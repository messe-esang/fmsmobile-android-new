<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/assign_layout"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical">

    <TextView
            android:id="@+id/assign_layout_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_class_company"
            android:textSize="12dp"
            android:textStyle="bold"/>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="right"
            android:orientation="horizontal">

        <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"/>

        <TextView
                android:id="@+id/assign_tot_cnt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:text="@string/str_assign_tot_cnt"
                android:textColor="@color/color_class_company"
                android:textSize="17dp"
                android:textStyle="bold"/>

        <TextView
                android:id="@+id/assign_my_cnt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_weight="1"
                android:gravity="right"
                android:text="@string/str_assign_my_cnt"
                android:textColor="@color/color_DC6A7A"
                android:textSize="17dp"
                android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>