<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.SearchActivity">

    <include layout="@layout/include_toolbar" />

    <RelativeLayout
        android:id="@+id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:layout_margin="@dimen/activity_horizontal_margin_little"
        android:background="@drawable/edittext_rounded_bg"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:padding="@dimen/activity_horizontal_margin_little">

        <EditText
            android:id="@+id/editSearch"
            style="@style/TextSubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:drawableLeft="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="업체명/브랜드명 검색"
            android:imeOptions="actionSearch"
            android:inputType="text" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layoutPhoneSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutSearch"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="11dp"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:background="@drawable/edittext_rounded_bg"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:padding="@dimen/activity_horizontal_margin_little">

            <EditText
                android:id="@+id/editPhoneSearch"
                style="@style/TextSubTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:drawableLeft="@android:drawable/ic_menu_search"
                android:drawablePadding="10dp"
                android:hint="전화번호 검색"
                android:imeOptions="actionSearch"
                android:inputType="phone" />

        </RelativeLayout>

        <Button
            android:id="@+id/btnPhoneSearch"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:layout_below="@+id/layoutSearch"
            android:layout_gravity="center"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/layoutPhoneSearch"
            android:background="@drawable/search_btn_rounded"
            android:text="검색"
            android:textColor="@android:color/white"
            android:textSize="17dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutPhoneSearch"
        android:layout_marginStart="11dp"
        android:layout_marginBottom="11dp"
        android:text="※ 전화번호로 검색하실 경우 오른쪽 검색 버튼을 눌러주세요."
        android:textColor="@color/color_DC6A7A"
        android:textSize="12dp" />

    <LinearLayout
        android:id="@+id/progressBar_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txt_info"
        android:background="#40000000"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <fr.castorflex.android.circularprogressbar.CircularProgressBar
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:indeterminate="true"
            app:cpb_color="@color/color_primary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txt_info"
        android:nestedScrollingEnabled="true" />

    <TextView
        android:id="@+id/txtEmpty"
        style="@style/TextSubTitle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txt_info"
        android:gravity="center"
        android:text="검색된 업체가 없습니다."
        android:textColor="@color/color_text_low"
        android:visibility="visible" />

    <fr.castorflex.android.smoothprogressbar.SmoothProgressBar
        android:id="@+id/smoothprogressbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:indeterminate="true"
        android:visibility="invisible"
        app:spb_color="@color/color_primary"
        app:spb_mirror_mode="true"
        app:spb_progressiveStart_activated="false"
        app:spb_progressiveStart_speed="2.0"
        app:spb_progressiveStop_speed="3.4"
        app:spb_reversed="true"
        app:spb_sections_count="4"
        app:spb_speed="2.0"
        app:spb_stroke_separator_length="4dp"
        app:spb_stroke_width="4dp" />

</RelativeLayout>