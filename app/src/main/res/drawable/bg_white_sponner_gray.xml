<?xml version="1.0" encoding="utf-8"?><!--<shape xmlns:android="http://schemas.android.com/apk/res/android" >-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/white" />
                    <stroke android:width="1dp" android:color="@color/color_gray_dark" />
                    <padding android:bottom="@dimen/activity_vertical_margin_little" android:left="@dimen/activity_horizontal_margin" android:right="@dimen/activity_horizontal_margin" android:top="@dimen/activity_vertical_margin_little" />
                    <corners android:radius="0dp" />
                </shape>
            </item>

            <item android:width="24dp" android:height="24dp" android:drawable="@drawable/baseline_arrow_drop_down_24" android:gravity="center|end" />
        </layer-list>
    </item>
</selector>