<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/color_9A9A9A" />
            <solid android:color="@color/color_9A9A9A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/color_9A9A9A" />
            <solid android:color="@color/color_9A9A9A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/color_9A9A9A" />
            <solid android:color="@color/color_9A9A9A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/color_9A9A9A" />
            <solid android:color="@color/color_9A9A9A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/color_class_company" />
            <solid android:color="@color/color_class_company" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>