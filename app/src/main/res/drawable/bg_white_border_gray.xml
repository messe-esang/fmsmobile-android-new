<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 🔹 비활성 상태 -->
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#F2F2F2"/>
            <stroke
                android:width="1dp"
                android:color="#DDDDDD"/>
            <padding
                android:bottom="@dimen/activity_vertical_margin_little"
                android:left="@dimen/activity_horizontal_margin"
                android:right="@dimen/activity_horizontal_margin"
                android:top="@dimen/activity_vertical_margin_little" />
        </shape>
    </item>

    <!-- 🔹 활성 상태 (기존 디자인) -->
    <item android:state_enabled="true">
        <shape>
            <solid android:color="@android:color/white"/>
            <stroke
                android:width="1dp"
                android:color="@color/color_gray_dark"/>
            <padding
                android:bottom="@dimen/activity_vertical_margin_little"
                android:left="@dimen/activity_horizontal_margin"
                android:right="@dimen/activity_horizontal_margin"
                android:top="@dimen/activity_vertical_margin_little" />
        </shape>
    </item>

</selector>