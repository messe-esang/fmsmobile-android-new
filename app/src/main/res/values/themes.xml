<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
<!--    <style name="Base.Theme.Fmsmobileandroidnew" parent="Theme.MaterialComponents.Light.NoActionBar">Theme.Material3.DayNight.NoActionBar-->
    <style name="Base.Theme.Fmsmobileandroidnew" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/color_accent</item>

        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>

        <item name="android:windowDisablePreview">true</item>

        <item name="snackbarStyle">@style/Snackbar.Margin.0dp</item>
        <item name="colorButtonNormal">@null</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorSurfaceContainer">@android:color/white</item>
        <item name="android:popupMenuStyle">@style/PopupMenuWhite</item>
        <item name="android:popupBackground">@android:color/white</item>

    </style>
    <style name="PopupMenuWhite">
        <item name="android:popupBackground">@android:color/white</item>
    </style>

    <style name="Theme.Fmsmobileandroidnew" parent="Base.Theme.Fmsmobileandroidnew" />

    <style name="Snackbar.Margin.0dp" parent="@style/Widget.MaterialComponents.Snackbar">
        <item name="android:layout_margin">0dp</item>
    </style>

    <style name="Toolbar">
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
    </style>

    <style name="ToolbarColoredBackArrow" parent="Theme.Fmsmobileandroidnew">
        <item name="android:textColorSecondary">@color/color_primary</item>
    </style>

    <style name="Edit" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/gray_rounded_bg</item>
        <item name="android:textColor">#FF000000</item>
        <item name="android:textColorHint">@color/color_gray</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Login_Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_login_rounded</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Plan_Delete_Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/action_plan_delete_rounded</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18dp</item>
    </style>

    <style name="Plan_add_Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_login_rounded</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18dp</item>
    </style>

    <style name="Fair_Compare_Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/fair_compare_rounded</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18dp</item>
    </style>

    <style name="TextHeadlineBigBig">
        <item name="android:textSize">96sp</item>
    </style>

    <style name="TextHeadlineBig">
        <item name="android:textSize">60sp</item>
    </style>

    <style name="TextHeadline">
        <item name="android:textSize">48sp</item>
    </style>

    <style name="TextHeadlineSmall">
        <item name="android:textSize">34sp</item>
    </style>

    <style name="TextHeadlineSmallSmall">
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextSubTitle">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextCaption">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextError">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextOverline">
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TabTextTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NavWhiteTheme">
        <item name="colorSurface">@android:color/white</item>
    </style>
</resources>